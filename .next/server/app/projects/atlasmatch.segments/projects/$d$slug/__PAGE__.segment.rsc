15:["$","div",null,{"className":"case-sections","children":[["$","article","Context",{"children":[["$","h2",null,{"children":"Context"}],["$","p",null,{"children":"AtlasMatch is being shaped as a practical way for fans to discover host cities and their match-day surroundings."}]]}],["$","article","Problem",{"children":[["$","h2",null,{"children":"Problem"}],["$","p",null,{"children":"The catalog needed a clear, maintainable data model for several connected domain areas without mixing future community features into the current release."}]]}],["$","article","Solution",{"children":[["$","h2",null,{"children":"Solution"}],["$","p",null,{"children":"A modular catalog foundation exposes read-only endpoints for the seeded city, match, hotel, restaurant, transport, and place data."}]]}],["$","article","My contribution",{"children":[["$","h2",null,{"children":"My contribution"}],["$","p",null,{"children":"Focused on the backend catalog architecture: cities, matches, hotels, restaurants, transport, places, API design, entity relationships, and Flyway migrations."}]]}],["$","article","Architecture",{"children":[["$","h2",null,{"children":"Architecture"}],["$","p",null,{"children":"Spring Boot with JPA and PostgreSQL 17. Flyway owns the schema and seed data; Docker Compose provides a repeatable local stack."}]]}],["$","article","Challenges",{"children":[["$","h2",null,{"children":"Challenges"}],["$","p",null,{"children":"Keeping domain relationships, migrations, seed data, and public catalogue responses consistent while preserving room for later features."}]]}],["$","article","Lessons learned",{"children":[["$","h2",null,{"children":"Lessons learned"}],["$","p",null,{"children":"Clear ownership boundaries and migration discipline make a growing product easier to reason about."}]]}]]}]
