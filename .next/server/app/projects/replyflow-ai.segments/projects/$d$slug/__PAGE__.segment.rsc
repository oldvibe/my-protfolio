11:["$","div",null,{"className":"case-sections","children":[["$","article","Context",{"children":[["$","h2",null,{"children":"Context"}],["$","p",null,{"children":"ReplyFlow explores a calmer way to help small teams handle everyday customer questions across multiple languages."}]]}],["$","article","Problem",{"children":[["$","h2",null,{"children":"Problem"}],["$","p",null,{"children":"A useful prototype needed to be honest about what was automated while still making the response-selection flow feel tangible."}]]}],["$","article","Solution",{"children":[["$","h2",null,{"children":"Solution"}],["$","p",null,{"children":"The current prototype uses clearly labelled, preset templates with friendly and professional response directions."}]]}],["$","article","My contribution",{"children":[["$","h2",null,{"children":"My contribution"}],["$","p",null,{"children":"Designed and prototyped an interaction model around labelled template responses and tone-aware selection."}]]}],["$","article","Architecture",{"children":[["$","h2",null,{"children":"Architecture"}],["$","p",null,{"children":"A front-end product prototype focused on interaction states, language cues, and clear content hierarchy."}]]}],["$","article","Challenges",{"children":[["$","h2",null,{"children":"Challenges"}],["$","p",null,{"children":"Making the “AI” concept legible without representing planned live generation as an implemented capability."}]]}],["$","article","Lessons learned",{"children":[["$","h2",null,{"children":"Lessons learned"}],["$","p",null,{"children":"Trust improves when a product names the difference between what exists today and what is planned."}]]}]]}]
